# Project defaults applied when sdkconfig is (re)generated.
# The dev board has a 4 MB flash chip.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Custom partition table: the app embeds the PoP DAT files plus the pre-decoded
# sprite blob, which does not fit the default 1 MB single-app partition.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# 1 kHz scheduler tick: finer frame pacing (~12fps game tick), lower input
# latency, and finer scheduling headroom for the future audio task.
CONFIG_FREERTOS_HZ=1000
